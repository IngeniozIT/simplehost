<Window x:Class="SimpleHost.Presentation.CategoryPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Move to category"
        SizeToContent="Height"
        Width="360"
        MaxHeight="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- Pick the destination category for a move. The list is filled in code-behind from the current
         groups, with "No category" offered as the first option; OK is enabled once a row is picked. -->
    <StackPanel Margin="16">
        <TextBlock Text="Move to:" Margin="0,0,0,6" />
        <ListBox x:Name="CategoryList"
                 MaxHeight="320"
                 SelectionChanged="OnSelectionChanged"
                 MouseDoubleClick="OnListDoubleClick" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    MinWidth="80"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button x:Name="OkButton"
                    Content="Move"
                    MinWidth="80"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</Window>
