<Window x:Class="SimpleHost.Presentation.EntryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimpleHost.Presentation"
        Title="Edit entry"
        SizeToContent="Height"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!--
        Modal editor for one existing entry. Its DataContext is the main view-model's EditDraft
        (an EntryFormViewModel), populated by MainViewModel.BeginEditEntry before the dialog opens.
        OK is enabled only while the draft is valid; confirming closes with DialogResult=true so the
        window can stage the edit through MainViewModel.SaveEditedEntry.
    -->
    <StackPanel Margin="16">
        <local:EntryFormControl />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    MinWidth="80"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button Content="OK"
                    MinWidth="80"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    IsEnabled="{Binding IsValid}"
                    Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</Window>
