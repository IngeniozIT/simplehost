<ui:FluentWindow x:Class="SimpleHost.Presentation.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:SimpleHost.Presentation"
                 Title="SimpleHost"
                 Height="680"
                 Width="980"
                 MinHeight="480"
                 MinWidth="720"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:CountToVisibilityConverter x:Key="CountToVisibility" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="SimpleHost" />

        <TabControl Grid.Row="1" Margin="12,0,12,12">

            <!-- ================= ENTRIES ================= -->
            <TabItem Header="Entries">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Command bar: search + filter + add. -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <ui:TextBox x:Name="HostnameSearchBox"
                                        Width="240"
                                        Icon="{ui:SymbolIcon Search24}"
                                        PlaceholderText="Search hostname"
                                        Text="{Binding HostnameQuery, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:TextBox x:Name="IpSearchBox"
                                        Width="150"
                                        Margin="8,0,0,0"
                                        PlaceholderText="IP address"
                                        Text="{Binding IpAddressQuery, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox x:Name="CategoryFilterBox"
                                      Width="170"
                                      Margin="8,0,0,0"
                                      ItemsSource="{Binding Groups}"
                                      DisplayMemberPath="DisplayName"
                                      ToolTip="Show only one category"
                                      SelectionChanged="OnCategoryFilterChanged" />
                            <Button Content="Clear"
                                    Margin="8,0,0,0"
                                    ToolTip="Clear the search and category filter"
                                    Click="OnClearFiltersClick" />
                        </StackPanel>
                        <ui:Button Grid.Column="1"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Add24}"
                                   Content="Add entry"
                                   Click="OnAddEntryClick" />
                    </Grid>

                    <!-- Pending-changes bar: shown only while changes are staged. -->
                    <ui:Card Grid.Row="1"
                             Margin="0,0,0,12"
                             Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Edit24" Margin="0,0,10,0" />
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding PendingChangeCount, StringFormat='{}{0} unsaved change(s)'}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Preview"
                                        IsEnabled="{Binding HasPendingChanges}"
                                        Click="OnPreviewPendingChangesClick" />
                                <Button Content="Discard"
                                        Margin="8,0,0,0"
                                        Command="{Binding DiscardCommand}" />
                                <ui:Button Content="Apply"
                                           Appearance="Primary"
                                           Margin="8,0,0,0"
                                           Command="{Binding ApplyCommand}" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <!-- Conflict and duplicate warnings, each shown only when relevant. -->
                    <StackPanel Grid.Row="2">
                        <ui:Card Margin="0,0,0,12"
                                 Visibility="{Binding HasHostnameConflicts, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <ui:SymbolIcon Symbol="Warning24"
                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                   Margin="0,0,8,0" />
                                    <TextBlock Text="Hostname conflicts"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding HostnameConflictWarnings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Margin="0,0,0,12"
                                 Visibility="{Binding HasDuplicateEntries, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <ui:SymbolIcon Symbol="Warning24"
                                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                   Margin="0,0,8,0" />
                                    <TextBlock Text="Duplicate entries"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding DuplicateEntryWarnings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>

                    <!-- Contextual bulk-action bar: shown only while entries are selected. -->
                    <ui:Card Grid.Row="3"
                             Margin="0,0,0,12"
                             Visibility="{Binding SelectedEntries.Count, Converter={StaticResource CountToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedEntries.Count, StringFormat='{}{0} selected'}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Enable" Click="OnEnableSelectedClick" />
                                <Button Content="Disable" Margin="8,0,0,0" Click="OnDisableSelectedClick" />
                                <Button Content="Move to…" Margin="8,0,0,0" Click="OnMoveSelectedClick" />
                                <Button Content="Delete" Margin="8,0,0,0" Click="OnDeleteSelectedClick" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <!-- The grouped host entries: the "No category" group first, then each category. -->
                    <ScrollViewer Grid.Row="4"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding VisibleGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,18">

                                        <!-- Category header: name, count, and per-category actions.
                                             Dropping an entry here moves it into this category. -->
                                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="2,0,2,6"
                                                Margin="0,0,0,6"
                                                Background="Transparent"
                                                AllowDrop="True"
                                                DragOver="OnEntryDragOver"
                                                Drop="OnCategoryDrop">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center" />
                                                    <Border Margin="8,0,0,0"
                                                            Padding="7,1"
                                                            VerticalAlignment="Center"
                                                            CornerRadius="9"
                                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                        <TextBlock Text="{Binding Entries.Count}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="Enable all" Click="OnEnableCategoryClick" />
                                                    <Button Content="Disable all" Margin="6,0,0,0" Click="OnDisableCategoryClick" />
                                                    <Button x:Name="RenameCategoryButton"
                                                            Content="Rename" Margin="6,0,0,0" Click="OnRenameCategoryClick" />
                                                    <Button x:Name="DeleteCategoryButton"
                                                            Content="Delete" Margin="6,0,0,0" Click="OnDeleteCategoryClick" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Entries in this category. -->
                                        <ItemsControl ItemsSource="{Binding Entries}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="Row"
                                                            Padding="6,4"
                                                            Margin="0,1"
                                                            CornerRadius="6"
                                                            Background="Transparent"
                                                            AllowDrop="True"
                                                            PreviewMouseLeftButtonDown="OnRowMouseDown"
                                                            PreviewMouseMove="OnRowMouseMove"
                                                            DragOver="OnEntryDragOver"
                                                            Drop="OnRowDrop">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="150" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox Grid.Column="0"
                                                                      Margin="0,0,10,0"
                                                                      VerticalAlignment="Center"
                                                                      ToolTip="Select for a bulk action"
                                                                      Checked="OnEntrySelected"
                                                                      Unchecked="OnEntryDeselected" />

                                                            <ui:ToggleSwitch Grid.Column="1"
                                                                             Margin="0,0,14,0"
                                                                             VerticalAlignment="Center"
                                                                             ToolTip="Enable or disable this entry"
                                                                             IsChecked="{Binding IsActive, Mode=OneWay}"
                                                                             Click="OnRowToggle" />

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding IpAddress}"
                                                                       FontFamily="Consolas"
                                                                       VerticalAlignment="Center" />

                                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock x:Name="Host" Text="{Binding Hostname}" />
                                                                <TextBlock x:Name="Description"
                                                                           Text="{Binding Comment}"
                                                                           ToolTip="{Binding Comment}"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            </StackPanel>

                                                            <!-- Per-entry actions, revealed on hover to keep the row calm. -->
                                                            <StackPanel x:Name="RowActions"
                                                                        Grid.Column="4"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center"
                                                                        Opacity="0">
                                                                <Button Content="Edit" Click="OnEditEntryClick" />
                                                                <Button Content="Move" Margin="6,0,0,0" Click="OnMoveEntryClick" />
                                                                <Button Content="Delete" Margin="6,0,0,0" Click="OnDeleteEntryClick" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <DataTemplate.Triggers>
                                                        <!-- Disabled: dimmed row and struck-through hostname. -->
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter TargetName="Row" Property="Opacity" Value="0.55" />
                                                            <Setter TargetName="Host" Property="TextDecorations" Value="Strikethrough" />
                                                        </DataTrigger>
                                                        <!-- Hide the description line when the entry has no description. -->
                                                        <DataTrigger Binding="{Binding Comment}" Value="{x:Null}">
                                                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <!-- Reveal the row actions and highlight the row on hover. -->
                                                        <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowActions" Property="Opacity" Value="1" />
                                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>

                                    <DataTemplate.Triggers>
                                        <!-- The pinned "No category" group cannot be renamed or deleted. -->
                                        <DataTrigger Binding="{Binding IsUncategorized}" Value="True">
                                            <Setter TargetName="RenameCategoryButton" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="DeleteCategoryButton" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ================= PROFILES ================= -->
            <TabItem Header="Profiles">
                <StackPanel Margin="0,16,0,0" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="Profiles" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="A profile is a named set of enabled categories, e.g. 'Work' or 'Home'. Switching to one enables its categories and disables the rest as pending changes." />

                    <ui:Card Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Switch to a saved profile" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <ComboBox x:Name="ProfilesBox"
                                          Width="240"
                                          ItemsSource="{Binding Profiles}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Name"
                                          ToolTip="The saved profiles you can switch to" />
                                <Button Content="Switch to" Margin="8,0,0,0" Click="OnSwitchProfileClick" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Save the current setup as a profile" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBox x:Name="ProfileNameBox"
                                            Width="240"
                                            PlaceholderText="Profile name"
                                            ToolTip="Name to save the currently enabled categories under" />
                                <Button Content="Save profile" Margin="8,0,0,0" Click="OnSaveProfileClick" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Create a category" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBox x:Name="NewCategoryBox"
                                            Width="240"
                                            PlaceholderText="Category name" />
                                <Button Content="Create category" Margin="8,0,0,0" Click="OnCreateCategoryClick" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </TabItem>

            <!-- ================= SUBSCRIPTIONS ================= -->
            <TabItem Header="Subscriptions">
                <StackPanel Margin="0,16,0,0" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Remote subscriptions" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Subscribe to a remote hosts list (e.g. an ad-block list). Its entries are fetched into their own category and can be refreshed on demand." />

                    <ui:Card Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Add or refresh a subscription" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBox x:Name="SubscriptionUrlBox"
                                            Width="300"
                                            PlaceholderText="https://example.com/hosts"
                                            ToolTip="The remote hosts list to subscribe to or refresh" />
                                <ui:TextBox x:Name="SubscriptionCategoryBox"
                                            Width="160"
                                            Margin="8,0,0,0"
                                            PlaceholderText="Category"
                                            ToolTip="The category the subscription's entries live in" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ui:Button Content="Subscribe" Appearance="Primary" Click="OnSubscribeClick" />
                                <ui:Button Content="Refresh" Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowSync24}" Click="OnRefreshSubscriptionClick" />
                                <Button Content="Refresh all" Margin="8,0,0,0" Click="OnRefreshAllSubscriptionsClick" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>

                    <ItemsControl ItemsSource="{Binding SubscriptionRefreshResults}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </TabItem>

            <!-- ================= SETTINGS ================= -->
            <TabItem Header="Settings">
                <StackPanel Margin="0,16,0,0" MaxWidth="640" HorizontalAlignment="Left">
                    <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />

                    <ui:Card>
                        <ui:ToggleSwitch IsChecked="{Binding FlushDnsAfterSaving}"
                                         Content="Flush the DNS cache after saving"
                                         ToolTip="After a successful save that wrote changes, flush the system DNS cache so lookups pick up the change immediately" />
                    </ui:Card>

                    <TextBlock Text="Import / export" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,4" />
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Import entries from another hosts file into a category, or export a single category or the whole configuration as a standalone hosts file." />
                    <ui:Card Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox x:Name="TransferCategoryBox"
                                          Width="220"
                                          ItemsSource="{Binding Groups}"
                                          DisplayMemberPath="DisplayName"
                                          ToolTip="The category to import into or to export" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ui:Button Content="Import into…" Icon="{ui:SymbolIcon ArrowImport24}" Click="OnImportClick" />
                                <ui:Button Content="Export category…" Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowExport24}" Click="OnExportCategoryClick" />
                                <Button Content="Export all…" Margin="8,0,0,0" Click="OnExportConfigurationClick" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </TabItem>

        </TabControl>
    </Grid>
</ui:FluentWindow>
