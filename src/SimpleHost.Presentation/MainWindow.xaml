<Window x:Class="SimpleHost.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SimpleHost.Presentation"
        Title="SimpleHost"
        Height="600"
        Width="900"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource WindowForegroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- One warning line inside a warnings panel. -->
        <Style x:Key="WarningLineStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Pending-changes toolbar: shown only while changes are staged. It reports how many changes
             are waiting and drives the view-model to preview the diff, apply them to the hosts file, or
             discard them. Apply and Discard bind straight to the view-model's commands, which stay
             enabled only while there are pending changes. -->
        <Border DockPanel.Dock="Top"
                Visibility="{Binding HasPendingChanges, Converter={StaticResource BoolToVisibility}}"
                BorderBrush="{DynamicResource WindowForegroundBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Preview"
                            Padding="10,3"
                            IsEnabled="{Binding HasPendingChanges}"
                            Click="OnPreviewPendingChangesClick" />
                    <Button Content="Apply"
                            Margin="8,0,0,0"
                            Padding="10,3"
                            Command="{Binding ApplyCommand}" />
                    <Button Content="Discard"
                            Margin="8,0,0,0"
                            Padding="10,3"
                            Command="{Binding DiscardCommand}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="{Binding PendingChangeCount, StringFormat='{}{0} pending change(s) not yet written'}" />
            </DockPanel>
        </Border>

        <!-- Conflict and duplicate warnings, each shown only when there is something to warn about. -->
        <StackPanel DockPanel.Dock="Top" Margin="12,12,12,0">

            <Border Visibility="{Binding HasHostnameConflicts, Converter={StaticResource BoolToVisibility}}"
                    BorderBrush="#E5534B"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Hostname conflicts"
                               FontWeight="SemiBold"
                               Foreground="#E5534B" />
                    <ItemsControl ItemsSource="{Binding HostnameConflictWarnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource WarningLineStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Visibility="{Binding HasDuplicateEntries, Converter={StaticResource BoolToVisibility}}"
                    BorderBrush="#D9822B"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Duplicate entries"
                               FontWeight="SemiBold"
                               Foreground="#D9822B" />
                    <ItemsControl ItemsSource="{Binding DuplicateEntryWarnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource WarningLineStyle}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- Search and category filter: narrow the displayed list by hostname, IP address or category.
             The hostname and IP boxes drive the view-model's search queries as the user types; the
             category box drives its category filter. The list bound below shows VisibleGroups, which
             the view-model keeps narrowed to what matches. -->
        <StackPanel DockPanel.Dock="Top" Margin="12,12,12,0" Orientation="Horizontal">
            <TextBlock Text="Host:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="HostnameSearchBox"
                     Width="170"
                     VerticalAlignment="Center"
                     ToolTip="Narrow the list to entries whose hostname contains this text"
                     Text="{Binding HostnameQuery, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="IP:" VerticalAlignment="Center" Margin="14,0,6,0" />
            <TextBox x:Name="IpSearchBox"
                     Width="140"
                     VerticalAlignment="Center"
                     ToolTip="Narrow the list to entries whose IP address contains this text"
                     Text="{Binding IpAddressQuery, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Category:" VerticalAlignment="Center" Margin="14,0,6,0" />
            <ComboBox x:Name="CategoryFilterBox"
                      Width="160"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding Groups}"
                      DisplayMemberPath="DisplayName"
                      ToolTip="Narrow the list to a single category"
                      SelectionChanged="OnCategoryFilterChanged" />
            <Button Content="Clear filters"
                    Margin="14,0,0,0"
                    Padding="8,2"
                    Click="OnClearFiltersClick" />
        </StackPanel>

        <!-- Category management and bulk actions. Creating a category stages an empty category; the
             bulk buttons act on the current multi-selection through the view-model. -->
        <StackPanel DockPanel.Dock="Top" Margin="12,12,12,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="New category:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="NewCategoryBox" Width="200" VerticalAlignment="Center" />
                <Button Content="Create category"
                        Margin="8,0,0,0"
                        Padding="8,2"
                        Click="OnCreateCategoryClick" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="With selected:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Content="Enable" Padding="8,2" Click="OnEnableSelectedClick" />
                <Button Content="Disable" Margin="6,0,0,0" Padding="8,2" Click="OnDisableSelectedClick" />
                <Button Content="Move to…" Margin="6,0,0,0" Padding="8,2" Click="OnMoveSelectedClick" />
                <Button Content="Delete" Margin="6,0,0,0" Padding="8,2" Click="OnDeleteSelectedClick" />
            </StackPanel>
        </StackPanel>

        <!-- Add a new entry: the shared entry form bound to the view-model's new-entry draft, with
             its inline IP/hostname validation, and an Add button enabled only while the draft is valid. -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource WindowForegroundBrush}"
                BorderThickness="0,1,0,0"
                Padding="12"
                Opacity="1">
            <StackPanel>
                <TextBlock Text="Add entry"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <local:EntryFormControl DataContext="{Binding NewEntry}" />
                <Button Content="Add"
                        HorizontalAlignment="Right"
                        MinWidth="90"
                        Padding="8,3"
                        Margin="0,10,0,0"
                        IsEnabled="{Binding NewEntry.IsValid}"
                        Click="OnAddEntryClick" />
            </StackPanel>
        </Border>

        <!-- The grouped host entries: the "No category" group first, then each category, in file order. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="12">
            <ItemsControl ItemsSource="{Binding VisibleGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,16">

                            <!-- Category header: its name plus per-category actions. Dropping an entry
                                 here moves it into this category. -->
                            <Border BorderBrush="{DynamicResource WindowForegroundBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="0,0,0,4"
                                    Margin="0,0,0,4"
                                    Opacity="0.85"
                                    Background="Transparent"
                                    AllowDrop="True"
                                    DragOver="OnEntryDragOver"
                                    Drop="OnCategoryDrop">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Enable all" Padding="6,1" Click="OnEnableCategoryClick" />
                                        <Button Content="Disable all" Margin="6,0,0,0" Padding="6,1" Click="OnDisableCategoryClick" />
                                        <Button x:Name="RenameCategoryButton"
                                                Content="Rename" Margin="6,0,0,0" Padding="6,1" Click="OnRenameCategoryClick" />
                                        <Button x:Name="DeleteCategoryButton"
                                                Content="Delete" Margin="6,0,0,0" Padding="6,1" Click="OnDeleteCategoryClick" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <!-- Entries in this category. -->
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" Padding="2,3"
                                                Background="Transparent"
                                                AllowDrop="True"
                                                PreviewMouseLeftButtonDown="OnRowMouseDown"
                                                PreviewMouseMove="OnRowMouseMove"
                                                DragOver="OnEntryDragOver"
                                                Drop="OnRowDrop">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="Auto" MinWidth="200" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Selection checkbox and active-versus-disabled status dot. -->
                                                <StackPanel Grid.Column="0"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <CheckBox Margin="0,0,8,0"
                                                              VerticalAlignment="Center"
                                                              Checked="OnEntrySelected"
                                                              Unchecked="OnEntryDeselected" />
                                                    <Ellipse x:Name="StatusDot"
                                                             Width="9"
                                                             Height="9"
                                                             Margin="0,0,10,0"
                                                             VerticalAlignment="Center" />
                                                </StackPanel>

                                                <TextBlock x:Name="Ip"
                                                           Grid.Column="1"
                                                           Text="{Binding IpAddress}"
                                                           FontFamily="Consolas"
                                                           VerticalAlignment="Center" />

                                                <TextBlock x:Name="Host"
                                                           Grid.Column="2"
                                                           Text="{Binding Hostname}"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,12,0" />

                                                <TextBlock x:Name="Comment"
                                                           Grid.Column="3"
                                                           Text="{Binding Comment, StringFormat='# {0}'}"
                                                           FontStyle="Italic"
                                                           Opacity="0.7"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />

                                                <!-- Per-entry actions: toggle status, move to another category,
                                                     edit through the modal editor, or delete after confirmation. -->
                                                <StackPanel x:Name="RowActions"
                                                            Grid.Column="4"
                                                            Orientation="Horizontal"
                                                            Margin="12,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <Button x:Name="StatusToggle"
                                                            Content="Disable"
                                                            Padding="8,1"
                                                            Click="OnToggleEntryStatusClick" />
                                                    <Button Content="Move"
                                                            Padding="8,1"
                                                            Margin="6,0,0,0"
                                                            Click="OnMoveEntryClick" />
                                                    <Button Content="Edit"
                                                            Padding="8,1"
                                                            Margin="6,0,0,0"
                                                            Click="OnEditEntryClick" />
                                                    <Button Content="Delete"
                                                            Padding="8,1"
                                                            Margin="6,0,0,0"
                                                            Click="OnDeleteEntryClick" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <!-- Active: green dot, full-strength row, toggle offers to disable. -->
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="StatusDot" Property="Fill" Value="#3FB950" />
                                                <Setter TargetName="StatusToggle" Property="Content" Value="Disable" />
                                            </DataTrigger>
                                            <!-- Disabled: grey dot, dimmed row, struck-through hostname, toggle offers to enable. -->
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter TargetName="StatusDot" Property="Fill" Value="#6E7681" />
                                                <Setter TargetName="Row" Property="Opacity" Value="0.5" />
                                                <Setter TargetName="Host" Property="TextDecorations" Value="Strikethrough" />
                                                <Setter TargetName="StatusToggle" Property="Content" Value="Enable" />
                                            </DataTrigger>
                                            <!-- Hide the comment column when the entry has no comment. -->
                                            <DataTrigger Binding="{Binding Comment}" Value="{x:Null}">
                                                <Setter TargetName="Comment" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>

                        <DataTemplate.Triggers>
                            <!-- The pinned "No category" group cannot be renamed or deleted. -->
                            <DataTrigger Binding="{Binding IsUncategorized}" Value="True">
                                <Setter TargetName="RenameCategoryButton" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="DeleteCategoryButton" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</Window>
