<Window x:Class="SimpleHost.Presentation.PendingChangesPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview pending changes"
        Height="500"
        Width="680"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- A read-only preview of what the hosts file will look like once the pending changes are
         applied, shown as a diff: added lines marked "+", removed lines marked "-", and the
         surrounding unchanged lines kept dimmed for context. Close simply dismisses the dialog;
         nothing here writes to the file. -->
    <DockPanel Margin="16">

        <TextBlock DockPanel.Dock="Top"
                   Text="What will be written to the hosts file:"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Close"
                    MinWidth="80"
                    Padding="8,3"
                    IsCancel="True"
                    IsDefault="True"
                    Click="OnCloseClick" />
        </StackPanel>

        <Grid>
            <!-- Shown when the pending changes turn out to be a no-op against the current file. -->
            <TextBlock x:Name="NoChangesLabel"
                       Text="These pending changes make no difference to the file."
                       TextWrapping="Wrap"
                       Opacity="0.8"
                       Visibility="Collapsed" />

            <Border x:Name="DiffPanel"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DiffLines">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="LineGrid" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" MinWidth="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="Marker"
                                               Grid.Column="0"
                                               FontFamily="Consolas"
                                               FontWeight="Bold" />

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Placement.Category, TargetNullValue='No category'}"
                                               FontStyle="Italic"
                                               Opacity="0.7"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,10,0" />

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Placement.Entry.IpAddress}"
                                               FontFamily="Consolas" />

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Placement.Entry.Hostname}"
                                               Margin="0,0,12,0" />

                                    <TextBlock x:Name="Comment"
                                               Grid.Column="4"
                                               Text="{Binding Placement.Entry.Comment, StringFormat='# {0}'}"
                                               FontStyle="Italic"
                                               Opacity="0.7"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <DataTemplate.Triggers>
                                    <!-- Added: green, marked with a plus. -->
                                    <DataTrigger Binding="{Binding Kind}" Value="Added">
                                        <Setter TargetName="Marker" Property="Text" Value="+" />
                                        <Setter TargetName="LineGrid" Property="TextBlock.Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                    <!-- Removed: red, marked with a minus. -->
                                    <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                        <Setter TargetName="Marker" Property="Text" Value="&#8722;" />
                                        <Setter TargetName="LineGrid" Property="TextBlock.Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                    <!-- Unchanged: no marker, dimmed as context. -->
                                    <DataTrigger Binding="{Binding Kind}" Value="Unchanged">
                                        <Setter TargetName="LineGrid" Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                    <!-- Hide the comment column when the entry has no comment. -->
                                    <DataTrigger Binding="{Binding Placement.Entry.Comment}" Value="{x:Null}">
                                        <Setter TargetName="Comment" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
