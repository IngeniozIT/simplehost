<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SimpleHost</AssemblyName>
    <RootNamespace>SimpleHost.Presentation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimpleHost.Application\SimpleHost.Application.csproj" />
    <ProjectReference Include="..\SimpleHost.Infrastructure\SimpleHost.Infrastructure.csproj" />
  </ItemGroup>

</Project>
