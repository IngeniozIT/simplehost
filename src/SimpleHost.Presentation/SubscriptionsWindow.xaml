<Window x:Class="SimpleHost.Presentation.SubscriptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Subscriptions"
        SizeToContent="Height"
        Width="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- The Subscriptions area, moved off the former tab into a modal dialog reached from the
         Subscriptions menu. It is bound to the same MainViewModel as the window, so subscribing and
         refreshing behave exactly as before, and results appear in the list below. -->
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Subscribe to a remote hosts list (e.g. an ad-block list). Its entries are fetched into their own category and can be refreshed on demand." />

        <ui:Card Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Add or refresh a subscription" FontWeight="SemiBold" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox x:Name="SubscriptionUrlBox"
                                Width="300"
                                PlaceholderText="https://example.com/hosts"
                                ToolTip="The remote hosts list to subscribe to or refresh" />
                    <ui:TextBox x:Name="SubscriptionCategoryBox"
                                Width="160"
                                Margin="8,0,0,0"
                                PlaceholderText="Category"
                                ToolTip="The category the subscription's entries live in" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ui:Button Content="Subscribe" Appearance="Primary" Click="OnSubscribeClick" />
                    <ui:Button Content="Refresh" Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowSync24}" Click="OnRefreshSubscriptionClick" />
                    <Button Content="Refresh all" Margin="8,0,0,0" Click="OnRefreshAllSubscriptionsClick" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <ItemsControl ItemsSource="{Binding SubscriptionRefreshResults}" Margin="0,12,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,0" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Close" MinWidth="80" IsCancel="True" IsDefault="True" Click="OnCloseClick" />
        </StackPanel>
    </StackPanel>
</Window>
