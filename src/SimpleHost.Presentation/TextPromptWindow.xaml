<Window x:Class="SimpleHost.Presentation.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SimpleHost"
        SizeToContent="Height"
        Width="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- A single-line text prompt, used for naming a category on rename. OK is enabled only while the
         box holds non-blank text; confirming closes with DialogResult=true. -->
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptLabel" Margin="0,0,0,6" TextWrapping="Wrap" />
        <TextBox x:Name="ResponseBox" TextChanged="OnResponseChanged" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Cancel"
                    MinWidth="80"
                    IsCancel="True"
                    Click="OnCancelClick" />
            <Button x:Name="OkButton"
                    Content="OK"
                    MinWidth="80"
                    Margin="8,0,0,0"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="OnOkClick" />
        </StackPanel>
    </StackPanel>
</Window>
