<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light appearance, shown when Windows is set to use light mode for apps. -->
    <Color x:Key="WindowBackgroundColor">#FFF3F3F3</Color>
    <Color x:Key="WindowForegroundColor">#FF1B1B1B</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="WindowForegroundBrush" Color="{StaticResource WindowForegroundColor}" />

</ResourceDictionary>
