<Project Sdk="Microsoft.NET.Sdk">

  <!-- Build-time helper (NOT part of the shipped app, and not in SimpleHost.slnx). Converts the
       single source PNG into a multi-resolution .ico. It is invoked by the GenerateAppIcon target in
       SimpleHost.Presentation.csproj during build/publish. Kept cross-platform on purpose: it uses
       SixLabors.ImageSharp (pure managed, no System.Drawing.Common, no ImageMagick) so it runs on the
       Linux/WSL 'dotnet publish' host. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SimpleHost.Tools.IconGenerator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

</Project>
